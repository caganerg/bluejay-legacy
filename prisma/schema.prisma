datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// 1. USER MODEL
// ----------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  
  folders       Folder[]
  notes         Note[]
  tags          Tag[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("users")
}

// ----------------------------------------------------
// 2. FOLDER SYSTEM (Hierarchical / Nested)
// ----------------------------------------------------

model Folder {
  id        String   @id @default(cuid())
  name      String
  
  parentId  String?
  parent    Folder?  @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[] @relation("FolderHierarchy")

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  notes     Note[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([parentId])
  @@map("folders")
}

// ----------------------------------------------------
// 3. NOTE MODEL (Markdown Structure)
// ----------------------------------------------------

model Note {
  id          String   @id @default(cuid())
  title       String
  slug        String
  content     String   @default("")
  
  isPinned    Boolean  @default(false)
  isArchived  Boolean  @default(false)

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  folderId    String?
  folder      Folder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)

  // Bi-directional linking (Graph View & Backlinks)
  outgoingLinks NoteLink[] @relation("SourceNote")
  incomingLinks NoteLink[] @relation("TargetNote")

  // Tags
  tags        NoteTag[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, slug])
  @@index([userId])
  @@index([folderId])
  @@index([title])
  @@map("notes")
}

// ----------------------------------------------------
// 4. REFERENCES BETWEEN NOTES (Wikilinks & Backlinks)
// ----------------------------------------------------

model NoteLink {
  id            String   @id @default(cuid())
  
  sourceNoteId  String
  sourceNote    Note     @relation("SourceNote", fields: [sourceNoteId], references: [id], onDelete: Cascade)

  targetNoteId  String?
  targetNote    Note?    @relation("TargetNote", fields: [targetNoteId], references: [id], onDelete: Cascade)

  targetTitle   String?  // Holds the title when the reference points to a note that does not exist yet

  createdAt     DateTime @default(now())

  @@unique([sourceNoteId, targetNoteId])
  @@index([sourceNoteId])
  @@index([targetNoteId])
  @@index([targetTitle])
  @@map("note_links")
}

// ----------------------------------------------------
// 5. TAGS
// ----------------------------------------------------

model Tag {
  id        String    @id @default(cuid())
  name      String
  color     String?   @default("#6366f1")
  
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  notes     NoteTag[]

  createdAt DateTime  @default(now())

  @@unique([userId, name])
  @@index([userId])
  @@map("tags")
}

model NoteTag {
  noteId String
  note   Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)
  
  tagId  String
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([noteId, tagId])
  @@map("note_tags")
}
