# --- Password protection -----------------------------------------------------
# The password that unlocks the vault. If it is unset, protection is OFF: anyone
# who can reach the app can read, modify and delete every note. That is why a
# password is mandatory when `NODE_ENV=production`; without one the app serves
# no requests (503).
BLUEJAY_PASSWORD=""

# Secret key that signs the session cookie. If unset, it is derived from the
# password; in that case changing the password invalidates open sessions. To
# generate a random value: bun -e 'console.log(crypto.randomUUID()+crypto.randomUUID())'
AUTH_SECRET=""

# Session lifetime in seconds (default: 7 days).
# SESSION_MAX_AGE="604800"

# Directory the runtime state is written to (default: <project>/.bluejay).
# The session "epoch" is kept here; logging out rotates that value and every
# issued session token is invalidated instantly. The directory MUST be WRITABLE,
# otherwise "Lock Vault" returns 500. It should be persistent: deleting it drops
# open sessions (the safe side), and in a container it must be mounted on a
# persistent volume.
# BLUEJAY_STATE_DIR="/var/lib/bluejay"

# --- Database ----------------------------------------------------------------
# PostgreSQL connection string. If it is unset the app runs in in-memory mode
# and data is lost when the process exits. If it is set, database errors are not
# swallowed; the API returns 500 (a visible error beats silently writing to the
# wrong store).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bluejay?schema=public"

# --- Network -----------------------------------------------------------------
# How many trusted reverse proxies sit in front of you. The rate limiter counts
# that many entries from the END of the `x-forwarded-for` chain; at 0 (the
# default) the header is not trusted at all. Behind a single proxy such as
# Nginx/Caddy, set this to "1".
# RATE_LIMIT_TRUSTED_PROXIES="0"

# Environment name. Next.js and src/lib/prisma.ts read it; even though the
# runtime is Bun, the variable keeps the name NODE_ENV.
NODE_ENV="development"
