# --- Parola koruması ---------------------------------------------------------
# Kasayı açan parola. Tanımlı değilse koruma KAPALIDIR: uygulamaya ulaşabilen
# herkes bütün notları okuyabilir, değiştirebilir ve silebilir. Bu yüzden
# `NODE_ENV=production` iken parola zorunludur; tanımlanmadan uygulama istek
# karşılamaz (503).
BLUEJAY_PASSWORD=""

# Oturum çerezini imzalayan gizli anahtar. Tanımlı değilse paroladan türetilir;
# o durumda parola değiştiğinde açık oturumlar geçersiz olur. Rastgele bir değer
# üretmek için: bun -e 'console.log(crypto.randomUUID()+crypto.randomUUID())'
AUTH_SECRET=""

# Oturum ömrü, saniye cinsinden (varsayılan: 7 gün).
# SESSION_MAX_AGE="604800"

# Çalışma zamanı durumunun yazıldığı dizin (varsayılan: <proje>/.bluejay).
# Burada oturum "epoch"u tutulur; çıkış yapıldığında bu değer döner ve verilmiş
# bütün oturum jetonları anında geçersiz olur. Dizin YAZILABİLİR olmak zorunda,
# aksi halde "Kasayı Kilitle" 500 döner. Kalıcı olmalı: silinirse açık oturumlar
# düşer (güvenli taraf), konteynerde ise kalıcı bir birime bağlanmalıdır.
# BLUEJAY_STATE_DIR="/var/lib/bluejay"

# --- Veritabanı --------------------------------------------------------------
# PostgreSQL bağlantı dizesi. Tanımlanmazsa uygulama bellek içi modda çalışır ve
# veriler süreç kapanınca kaybolur. Tanımlıysa veritabanı hataları yutulmaz;
# API 500 döner (sessizce yanlış depoya yazmaktansa görünür hata).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bluejay?schema=public"

# --- Ağ ----------------------------------------------------------------------
# Önünüzde kaç güvenilir ters proxy olduğu. Rate limiter `x-forwarded-for`
# zincirini SONDAN bu kadar sayar; 0 (varsayılan) iken başlığa hiç güvenilmez.
# Nginx/Caddy gibi tek bir proxy arkasındaysanız "1" yazın.
# RATE_LIMIT_TRUSTED_PROXIES="0"

# Ortam adı. Next.js ve src/lib/prisma.ts bunu okur; çalışma zamanı Bun olsa da
# değişkenin adı NODE_ENV olarak kalır.
NODE_ENV="development"
